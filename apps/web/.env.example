# Laboratorio técnico /avatar-lab. El valor predeterminado carga el rig V5 local;
# usa "off" para iniciar con la figura provisional o define otra ruta .glb.
NEXT_PUBLIC_AVATAR_MODEL_URL=/avatars/signalink_avatar_v5_refined.glb

# Supabase: copiar desde el diálogo Connect del proyecto.
# La publishable key puede estar expuesta en el cliente; nunca uses service_role ni sb_secret aquí.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Landmarks LSB en el navegador. Usa "off" para desactivarlos por defecto.
NEXT_PUBLIC_SIGN_LANDMARKS=on
# WASM: por defecto se sirve desde /mediapipe/wasm con los archivos del paquete instalado.
# El modelo Holistic sí usa Google Storage por defecto; fija ambas rutas a recursos propios si corresponde.
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=
NEXT_PUBLIC_MEDIAPIPE_HOLISTIC_MODEL_URL=
# Fijar las tres propiedades juntas tras revisar el archivo exacto; vacío conserva
# el modelo externo sin verificación y SIN CacheStorage persistente de la app.
# URL recomendada: /models/holistic/<version>/holistic_landmarker.task
NEXT_PUBLIC_MEDIAPIPE_HOLISTIC_MODEL_VERSION=
NEXT_PUBLIC_MEDIAPIPE_HOLISTIC_MODEL_SHA256=
NEXT_PUBLIC_MEDIAPIPE_HOLISTIC_MODEL_BYTES=
# Prototipo optativo: "on" mueve Holistic a un Worker; vacío conserva el baseline.
# Requiere reiniciar Next al cambiarlo. Diagnóstico muestra modo real y fallback.
NEXT_PUBLIC_MEDIAPIPE_WORKER=

# Visor LSB activo: el avatar incluido está disponible bajo demanda; "off" lo desactiva.
# Solo se carga al solicitar una expresión con un clip asociado.
NEXT_PUBLIC_LSB_AVATAR_MODEL_URL=
